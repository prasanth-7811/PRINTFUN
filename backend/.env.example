# ---------------------------------------------------------------------------
# Database — Supabase (Postgres)
#   Project URL → Settings → Database → "Connection string" → URI.
# Use the POOLER connection (port 6543) everywhere by default — it recovers
# from serverless cold starts and shared connections on Vercel/Render, which
# kill direct connections. The `?pgbouncer=true` param is required by the
# pooler, and the `postgresql+psycopg2://` prefix pins the driver to psycopg2
# (the one installed by requirements.txt).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432). Only for long-lived servers, CLI tools, and
# the first `flask db upgrade`. Commented out to keep one source of truth.
# DATABASE_URL_DIRECT=postgresql+psycopg2://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Secrets (CHANGE ALL OF THESE IN PRODUCTION)
# ---------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this
SECRET_KEY=your-flask-secret-key-change-this
FLASK_ENV=development

# ---------------------------------------------------------------------------
# Frontend origin — used to build verification & reset links in emails
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email delivery — pick ONE provider. Both are supported.
# ---------------------------------------------------------------------------
# Option A: Resend  (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=TEEZO <noreply@teezo.com>

# Option B: Brevo  (https://brevo.com)
BREVO_API_KEY=
# Brevo SMTP (alternative to the API above):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Support address shown in the email footer
SUPPORT_EMAIL=hello@teezo.com

# Dev only: also return the verification/reset link in the API response so the
# flow can be tested without a live email provider. Leave blank in production.
DEV_RETURN_TOKEN=

# ---------------------------------------------------------------------------
# WhatsApp order alerts — a message is sent to the store owner on every order.
# Pick ONE provider. With neither set, the message is printed to stdout (dev).
# ---------------------------------------------------------------------------
# Store-owner WhatsApp number that receives the alert (E.164 format).
ORDER_ALERT_PHONE=+919600650612

# Option A: Twilio WhatsApp (https://twilio.com/whatsapp)
#   For testing, join the Twilio WhatsApp sandbox from ORDER_ALERT_PHONE and
#   set TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Production only: an approved Content template (required outside the 24h window)
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_CONTENT_VARS={}

# Option B: Meta WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Production only: an approved template name (required outside the 24h window)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ---------------------------------------------------------------------------
# AWS S3 (leave blank for local file storage)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Payment Gateway
# ---------------------------------------------------------------------------
PAYMENT_API_KEY=

# ---------------------------------------------------------------------------
# Rate limiting — set REDIS_URL in production so limits are shared
# across gunicorn workers. In-memory is fine for local dev.
# ---------------------------------------------------------------------------
REDIS_URL=
RATELIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Database — PostgreSQL is required
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/teezo

# ---------------------------------------------------------------------------
# Secrets (CHANGE ALL OF THESE IN PRODUCTION)
# ---------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this
SECRET_KEY=your-flask-secret-key-change-this
FLASK_ENV=development

# ---------------------------------------------------------------------------
# Frontend origin — used to build verification & reset links in emails
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email delivery — pick ONE provider. Both are supported.
# ---------------------------------------------------------------------------
# Option A: Resend  (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=TEEZO <noreply@teezo.com>

# Option B: Brevo  (https://brevo.com)
BREVO_API_KEY=
# Brevo SMTP (alternative to the API above):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Support address shown in the email footer
SUPPORT_EMAIL=hello@teezo.com

# Dev only: also return the verification/reset link in the API response so the
# flow can be tested without a live email provider. Leave blank in production.
DEV_RETURN_TOKEN=

# ---------------------------------------------------------------------------
# AWS S3 (leave blank for local file storage)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Payment Gateway
# ---------------------------------------------------------------------------
PAYMENT_API_KEY=

# ---------------------------------------------------------------------------
# Rate limiting — set REDIS_URL in production so limits are shared
# across gunicorn workers. In-memory is fine for local dev.
# ---------------------------------------------------------------------------
REDIS_URL=
RATELIMIT_ENABLED=true

# ===========================================================================
# TEEZO — environment variables.
#   cp .env.example backend/.env   then fill in the values you need.
# Only this file is tracked. backend/.env is gitignored — put production keys
# in your host's dashboard (Vercel / Render / Railway) instead of the file.
# ===========================================================================

# --- Database --------------------------------------------------------------
# PostgreSQL is required for production. SQLite is fine locally.
DATABASE_URL=postgresql://postgres:password@localhost:5432/teezo

# --- Secrets (CHANGE ALL OF THESE IN PRODUCTION) ---------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this
SECRET_KEY=your-flask-secret-key-change-this
FLASK_ENV=development

# --- Frontend origin -------------------------------------------------------
# Public frontend URL — used to build the email verification & reset links.
# No trailing slash. Must be reachable by the user clicking the link.
FRONTEND_URL=http://localhost:5173

# --- Email delivery — pick ONE provider ------------------------------------
# Priority order: Resend, then Brevo, then SMTP.
# With none set, the email body is printed to stdout (dev only).
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TEEZO <noreply@teezo.com>
SUPPORT_EMAIL=hello@teezo.com

# --- Phone verification (SMS OTP) — pick ONE provider ----------------------
# Priority order: Twilio, then MSG91, then Brevo SMS.
# With none set, the code is printed to stdout (dev only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=TEEZO
MSG91_OTP_TEMPLATE_ID=
SMS_FROM=TEEZO

# --- Dev only --------------------------------------------------------------
# Returns the verification link and the OTP in the API response so the flow
# can be tested without a live provider. MUST be false in production.
DEV_RETURN_TOKEN=true

# --- AWS S3 (leave blank for local file storage) ---------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1

# --- Rate limiting ---------------------------------------------------------
# Set REDIS_URL in production so limits are shared across workers.
REDIS_URL=
RATELIMIT_ENABLED=true

# --- Other integrations ----------------------------------------------------
PAYMENT_API_KEY=
